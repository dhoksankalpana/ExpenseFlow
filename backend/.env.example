# ExpenseFlow backend configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Replace with your own PostgreSQL connection string
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/YOUR_DB_NAME

# Generate separate, random secrets for your own environment
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
CSRF_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
